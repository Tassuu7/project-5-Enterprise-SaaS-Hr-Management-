# WorkSphere Enterprise HRMS Configuration Template
# DO NOT COMMIT ACTUAL SECRETS TO REPOSITORY

NODE_ENV=development
PORT=3000
HOST=127.0.0.1
APP_NAME=WorkSphere Enterprise HRMS
APP_URL=http://localhost:3000

# Security & Tokens
JWT_SECRET=your_super_secret_enterprise_jwt_key_here_change_in_production
JWT_EXPIRES_IN=86400
BCRYPT_SALT_ROUNDS=10
SESSION_SECRET=enterprise_session_secret_cookie_hash_here

# Database
DB_DIALECT=sqlite
DB_STORAGE=./storage/database.sqlite
DB_POOL_MIN=2
DB_POOL_MAX=20

# SaaS Multi-Tenancy
DEFAULT_TENANT_ID=org_tenant_enterprise_001
TENANT_ISOLATION_MODE=schema

# Storage & Uploads
UPLOAD_DIR=./storage/uploads
MAX_FILE_SIZE_MB=25

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Audit Logging
AUDIT_LOG_ENABLED=true
AUDIT_RETENTION_DAYS=365
